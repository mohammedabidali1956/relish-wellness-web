
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/google5d006f26e5daf13c.html",
      "destination": "/api/google5d006f26e5daf13c"
    },
    {
      "source": "/googleda41df8ea84cf8c1.html",
      "destination": "/api/googleda41df8ea84cf8c1"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/llms-full.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/ai.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
